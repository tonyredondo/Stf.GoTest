<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Stf.GoTest</PackageId>
    <Version>0.1.58</Version>
    <Description>Go-style single-project tests: *.Test.cs compiles into the test build, excluded from prod. No InternalsVisibleTo.</Description>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Opt out of self-application: this packaging project is not a Go-style test project. -->
    <StfTest>false</StfTest>
    <IsTestProject>false</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- No framework dependencies on purpose: test-framework packages only deploy
       their runtime files (testhost, adapters) when referenced DIRECTLY, never
       transitively. Consumers add their framework (xunit/NUnit/MSTest) with a
       normal direct PackageReference; this package contributes MSBuild wiring. -->

  <!-- Outer multi-framework builds also need command dispatch before NuGet
       decides whether a test project is packable. -->
  <ItemGroup>
    <Compile Remove="StfRunProd.cs" />
    <Content Include="StfRunProd.cs;Stf.GoTest.props;Stf.GoTest.targets;Stf.GoTest.Pack.targets;Stf.GoTest.Publish.targets"
             PackagePath="build/;buildTransitive/;buildMultiTargeting/" Pack="true" />
    <Content Include="Sdk/*.props;Sdk/*.targets" PackagePath="Sdk/" Pack="true" />
  </ItemGroup>
</Project>
