<Project TreatAsLocalProperty="AfterMicrosoftNETSdkTargets;NuGetBuildTasksPackTargets">
  <!-- Compose SDK extension imports even when supplied with -p:. Preserve the
       original global values when forwarding to the production evaluation. -->
  <UsingTask TaskName="StfRunProd" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)StfRunProd.cs" />
    </Task>
  </UsingTask>
  <!-- Canonical flag readings. -p:/env values are GLOBAL (immutable), so a
       flag is never rewritten — conditions read a twin instead. Twins
       redefine here (twins are never global) because the body runs after
       props and may change raw values; props defines the twins it needs
       for the same reason. Each twin is CLEAR-then-SET: a conditional
       assignment with a false condition never unsets, so without the
       unconditional clear a props-time 'true' would survive a body-time
       'false' (verified via -pp: stale twin skipped the prod heal).
       Twin polarity per use site: 'XIsTrue' for =true/!=true sites,
       'XIsFalse' for !=false sites. Unknown spellings leave both unset:
       opt-in sites stay off, opt-out sites stay on — fail-open toward
       tests, exactly like raw comparisons before. -->
  <PropertyGroup>
    <StfTestIsTrue></StfTestIsTrue>
    <StfTestIsTrue Condition="'$(StfTest)' == 'true' OR '$(StfTest)' == '1' OR '$(StfTest)' == 'yes' OR '$(StfTest)' == 'y' OR '$(StfTest)' == 'on'">true</StfTestIsTrue>
    <StfSeparateOutputsIsTrue></StfSeparateOutputsIsTrue>
    <StfSeparateOutputsIsTrue Condition="'$(StfSeparateOutputs)' == 'true' OR '$(StfSeparateOutputs)' == '1' OR '$(StfSeparateOutputs)' == 'yes' OR '$(StfSeparateOutputs)' == 'y' OR '$(StfSeparateOutputs)' == 'on'">true</StfSeparateOutputsIsTrue>
    <StfSeparateOutputsIsFalse></StfSeparateOutputsIsFalse>
    <StfSeparateOutputsIsFalse Condition="'$(StfSeparateOutputs)' == 'false' OR '$(StfSeparateOutputs)' == '0' OR '$(StfSeparateOutputs)' == 'no' OR '$(StfSeparateOutputs)' == 'n' OR '$(StfSeparateOutputs)' == 'off'">true</StfSeparateOutputsIsFalse>
    <StfDualBuildIsFalse></StfDualBuildIsFalse>
    <StfDualBuildIsFalse Condition="'$(StfDualBuild)' == 'false' OR '$(StfDualBuild)' == '0' OR '$(StfDualBuild)' == 'no' OR '$(StfDualBuild)' == 'n' OR '$(StfDualBuild)' == 'off'">true</StfDualBuildIsFalse>
    <StfAllowExeTestModeIsTrue></StfAllowExeTestModeIsTrue>
    <StfAllowExeTestModeIsTrue Condition="'$(StfAllowExeTestMode)' == 'true' OR '$(StfAllowExeTestMode)' == '1' OR '$(StfAllowExeTestMode)' == 'yes' OR '$(StfAllowExeTestMode)' == 'y' OR '$(StfAllowExeTestMode)' == 'on'">true</StfAllowExeTestModeIsTrue>
    <StfAllowTestSlicePackIsTrue></StfAllowTestSlicePackIsTrue>
    <StfAllowTestSlicePackIsTrue Condition="'$(StfAllowTestSlicePack)' == 'true' OR '$(StfAllowTestSlicePack)' == '1' OR '$(StfAllowTestSlicePack)' == 'yes' OR '$(StfAllowTestSlicePack)' == 'y' OR '$(StfAllowTestSlicePack)' == 'on'">true</StfAllowTestSlicePackIsTrue>
    <StfAllowTestSlicePublishIsTrue></StfAllowTestSlicePublishIsTrue>
    <StfAllowTestSlicePublishIsTrue Condition="'$(StfAllowTestSlicePublish)' == 'true' OR '$(StfAllowTestSlicePublish)' == '1' OR '$(StfAllowTestSlicePublish)' == 'yes' OR '$(StfAllowTestSlicePublish)' == 'y' OR '$(StfAllowTestSlicePublish)' == 'on'">true</StfAllowTestSlicePublishIsTrue>
    <StfAllowPackIsFalse></StfAllowPackIsFalse>
    <StfAllowPackIsFalse Condition="'$(StfAllowPack)' == 'false' OR '$(StfAllowPack)' == '0' OR '$(StfAllowPack)' == 'no' OR '$(StfAllowPack)' == 'n' OR '$(StfAllowPack)' == 'off'">true</StfAllowPackIsFalse>
    <StfAllowBareTestRefsIsTrue></StfAllowBareTestRefsIsTrue>
    <StfAllowBareTestRefsIsTrue Condition="'$(StfAllowBareTestRefs)' == 'true' OR '$(StfAllowBareTestRefs)' == '1' OR '$(StfAllowBareTestRefs)' == 'yes' OR '$(StfAllowBareTestRefs)' == 'y' OR '$(StfAllowBareTestRefs)' == 'on'">true</StfAllowBareTestRefsIsTrue>
  </PropertyGroup>
  <!-- Project-body shipping options are available only now. Reconcile the
       SDK's early production default before the item evaluation pass collects
       conditional PackageReferences. An explicit command-line StfTest remains
       authoritative: the SDK never marks it as a default. -->
  <PropertyGroup Condition="'$(StfSdkMode)' == 'true' AND '$(_StfSdkDefaultedToProd)' == 'true' AND '$(StfTest)' == 'false' AND ('$(StfAllowTestSlicePackIsTrue)' == 'true' OR ('$(_IsPublishing)' == 'true' AND '$(StfAllowTestSlicePublishIsTrue)' == 'true') OR ('$(_IsPacking)' == 'true' AND '$(StfAllowPackIsFalse)' == 'true'))">
    <StfTest>true</StfTest>
    <StfTestIsTrue>true</StfTestIsTrue>
  </PropertyGroup>
  <!-- Heal the opposite transition too: body-time test opt-ins did not run
       the test initialization in props. Keep explicitly supplied constants. -->
  <PropertyGroup Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfTestDefineApplied)' != 'true'">
    <DefineConstants>$(DefineConstants);STF_TEST</DefineConstants>
    <StfTestDefineApplied>true</StfTestDefineApplied>
    <IsTestProject Condition="'$(IsTestProject)' == ''">true</IsTestProject>
    <GenerateRuntimeConfigurationFiles Condition="'$(GenerateRuntimeConfigurationFiles)' == ''">true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <!--
    A Go-style project is always packable: pack ships the prod slice (tests are
    stripped by the Compile Remove group below). Microsoft.NET.Test.Sdk flips
    IsPackable to false for test projects; restore it here. This file is imported
    after the Test SDK targets, so this wins. Opt out with -p:StfAllowPack=false
    (pack then behaves like a plain test project: no prod redirect, no obj/
    burial — the static redirect below stands down too).
  -->
  <PropertyGroup Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfAllowPackIsFalse)' != 'true'">
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Body-time override healing. The props default (StfTest=true) fires BEFORE
       the consumer body, so a body-time <StfTest>false</StfTest> (the exe
       opt-out) lands after props already derived test-mode values. -p:/env
       arrive before props and never need this. Heal exactly what WE applied
       (applied-flags from props), never user values. Deliberately NOT
       healed: GenerateRuntimeConfigurationFiles lingers true for body-false
       libraries — one extra runtimeconfig.json, zero risk (exe needs it true
       anyway). IsTestProject self-heals via the group below; outputs and
       intermediates separate at build time (the target below), already
       final, so body-time StfTest=false needs no path healing: prod
       evaluations are never poisoned. -->
  <!-- Test-root separation runs at BUILD time (BeforeTargets=PrepareForBuild),
       never at evaluation: the SDK derives outputs in several passes with
       mixed separator conventions per property (verified: one eval where a
       literal Replace matched TargetDir but missed OutputPath/OutDir, plus a
       restore-path overwrite with absolute paths), so evaluation-time string
       surgery is fragile by construction. Here every value is final: each
       path is absolutized, checked for containment under the recorded base,
       and re-rooted under base/test/. Body-time StfTest=false needs no
       healing: this never runs for it, so prod evaluations are never
       poisoned (the exewithline CI case proves it). VSTest is hooked too so
       no-build runs resolve the same slice. StfSeparated keeps the target
       idempotent within one execution (a second run would nest test/test/).
       Skipped paths (outside the base, e.g. the obj/ pack/publish redirects)
       keep working untouched, exactly like a plain project. Design-time IDE
       builds may not run this hook; compilation is unaffected either way.
       BeforeClean is hooked too: without it, test-mode 'dotnet clean'
       resolves default paths and wipes NEITHER slice (verified); with it,
       the test slice cleans and the nested target below takes prod. -->
  <Target Name="StfSeparateTestOutputs"
          BeforeTargets="PrepareForBuild;VSTest;BeforeClean"
          Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfSeparateOutputsIsTrue)' == 'true' AND '$(StfSeparated)' == '' AND '$(BaseOutputPath)' != ''">
    <PropertyGroup>
      <StfTestBaseAbs>$([MSBuild]::NormalizeDirectory($([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(BaseOutputPath)))))</StfTestBaseAbs>
      <StfTestRootAbs>$(StfTestBaseAbs)test/</StfTestRootAbs>
      <StfSeparated>true</StfSeparated>
      <BaseOutputPath>$(StfTestRootAbs)</BaseOutputPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(OutputPath)))</_StfA>
      <OutputPath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</OutputPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(OutDir)))</_StfA>
      <OutDir Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</OutDir>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(TargetDir)))</_StfA>
      <TargetDir Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</TargetDir>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(TargetPath)))</_StfA>
      <TargetPath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</TargetPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(FinalOutputPath)))</_StfA>
      <FinalOutputPath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</FinalOutputPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(PackageOutputPath)))</_StfA>
      <PackageOutputPath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</PackageOutputPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(PublishDir)))</_StfA>
      <PublishDir Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</PublishDir>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(_NormalizedPublishDir)))</_StfA>
      <_NormalizedPublishDir Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</_NormalizedPublishDir>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(ProjectDepsFilePath)))</_StfA>
      <ProjectDepsFilePath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</ProjectDepsFilePath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(ProjectRuntimeConfigFilePath)))</_StfA>
      <ProjectRuntimeConfigFilePath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</ProjectRuntimeConfigFilePath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(ProjectRuntimeConfigDevFilePath)))</_StfA>
      <ProjectRuntimeConfigDevFilePath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</ProjectRuntimeConfigDevFilePath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(PublishedSingleFilePath)))</_StfA>
      <PublishedSingleFilePath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</PublishedSingleFilePath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(ClickOncePublishDir)))</_StfA>
      <ClickOncePublishDir Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</ClickOncePublishDir>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(_WindowsMetadataOutputPath)))</_StfA>
      <_WindowsMetadataOutputPath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</_WindowsMetadataOutputPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(_WinMDDebugSymbolsOutputPath)))</_StfA>
      <_WinMDDebugSymbolsOutputPath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</_WinMDDebugSymbolsOutputPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(_WinMDDocFileOutputPath)))</_StfA>
      <_WinMDDocFileOutputPath Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</_WinMDDocFileOutputPath>
      <_StfA>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(AppConfigFileDestination)))</_StfA>
      <AppConfigFileDestination Condition="$([System.String]::Copy(&quot;$(_StfA)&quot;).StartsWith(&quot;$(StfTestBaseAbs)&quot;))">$(StfTestRootAbs)$([System.String]::Copy(&quot;$(_StfA)&quot;).Substring($(StfTestBaseAbs.Length)))</AppConfigFileDestination>
    </PropertyGroup>
  </Target>
  <!-- Padded whole-token removal: a flat Replace(';STF_TEST', '') corrupts
       constants that merely START with the marker (e.g. STF_TESTING becomes
       ING) and misses a leading-position marker (no leading ';'). Padding
       both ends makes every occurrence delimited, so only the whole token
       goes; Trim restores the original shape. Also heals a pre-existing
       duplicate when the consumer body already defined STF_TEST. -->
  <PropertyGroup Condition="'$(StfTestIsTrue)' != 'true' AND '$(StfTestDefineApplied)' == 'true'">
    <DefineConstants>$([System.String]::Copy(';$(DefineConstants);').Replace(';STF_TEST;', ';').Trim(';'))</DefineConstants>
  </PropertyGroup>

  <!-- In prod mode this must NOT look like a test project: a direct Test SDK
       reference sets IsTestProject=true unconditionally, and NuGet then forces
       IsPackable=false (silent pack no-op). Our file imports after the Test SDK
       props, so this wins. Test mode is untouched (dotnet test keeps working). -->
  <PropertyGroup Condition="'$(StfTestIsTrue)' != 'true' AND '$(IsTestProject)' != ''">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!-- Exe + test mode is UNSALVAGEABLE upstream (not a default we can flip):
       Microsoft.NET.Test.Sdk injects Program.Main alongside the user's Main,
       so the test-slice compile dies with CS0017 before any hook runs.
       Auto-flipping StfTest in THIS file cannot work: the consumer's
       conditioned refs are collected (project body) and Test SDK targets
       imported (restore closure) with the props-time default, long before
       OutputType is known — a late flip heals neither. So exe projects opt
       out with ONE body-time line right after <OutputType>:
         <StfTest>false</StfTest>
       (later assignment wins: ref conditions and restore then evaluate prod
       from build #1, single pass, zero flags on every command). A missing
       line fails LOUD below with the fix instead of cryptic CS0017. Explicit
       -p:StfTest=true on an exe is equally dead and fails the same way
       (even with StartupObject the tests could never run: the forced entry
       point would be the user's Main, not testhost).
       SCOPE (honest heuristic): a real entry point is undecidable at
       evaluation time, and effective OutputType=Exe does NOT prove one:
       unset OutputType evaluates to Library here (the Test SDK flips it to
       Exe later), yet every zero-config LIBRARY still looks "Exe" to a naive
       gate at some point — gating on OutputType alone blocks the core
       scenario (verified by breaking Demo).
       So the guard fires only when an entry point is PROVABLE BY CONVENTION:
       WinExe (never defaulted, ~always has a Main) or a Program.cs in
       @(Compile) (== is case-insensitive; Program.Test.cs never matches;
       the Test SDK's own injected file is named Microsoft.NET.Test.Sdk
       .Program.cs and never self-matches). MISSES (status quo ante, cryptic
       CS0017): Main in a non-conventional filename, WPF App.xaml (generated
       Main). FALSE POSITIVE (only one): a library with a Main-less file
       named Program.cs — perverse, and escapable via
       -p:StfAllowExeTestMode=true. -->
  <!-- Exe guard: fires only for REAL exes, never for libraries. THREE verified
       walls forced this exact shape:
       - A task condition over two item lists never matches (no cross-product
         batching), and eval-time ItemGroup metadata filters die with MSB4190.
         So the guard is FULLY SCALAR (no batching anywhere).
       - Effective OutputType=Exe does NOT prove a real exe: the SDK defaults
         unset OutputType to Library (verified reassignment) and the Test SDK
         flips it to Exe later — so every zero-config LIBRARY is "Exe" here.
         Gating on OutputType broke Demo; gating on a Program.cs glob
         false-positives on libraries that merely own such a file.
       - $(UseAppHost) IS the intent signal (verified across four projects):
         the SDK defaults it from the body-visible OutputType, BEFORE the
         Test SDK flip — explicit Exe/WinExe get true, flipped libraries stay
         empty. lib-no-Main, Demo: empty (silent); real exe, WinExe: true.
       - TestSDK presence comes from $(PkgMicrosoft_NET_Test_Sdk), defined
         only with GeneratePathProperty on the Test SDK ref (one inert
         metadata in the snippet). Plain exes without tests stay silent.
       Every remaining red is upstream-inevitable (a real collision dies with
       CS0017 anyway), so this stays an ERROR: actionable-red beats
       cryptic-red, and onboarding breaks nothing. Residual misses (status
       quo ante, cryptic CS0017): old snippets without GeneratePathProperty,
       explicit <UseAppHost>false</UseAppHost> exes, degraded restores that
       drop the Pkg property (observed: WinExe restored off-Windows).
       StfAllowExeTestMode=true silences (explicit-apphost library edge). -->
  <!-- Test-mode exe entry removal (instead of erroring): the user's Main is
       only needed to SHIP; in the test slice it just collides with the
       Test SDK's injected Main (CS0017). So when this is a real exe
       (UseAppHost, the body-explicit intent signal — flipped libraries stay
       empty and are untouched) with tests, drop the conventional entry file
       from the TEST compilation: the slice builds with the single testhost
       entry and `dotnet test` runs. Keep Program.cs thin (entry only): types
       used by tests must live in other files — a test referencing a type
       declared in Program.cs fails LOUD (missing type), never silent.
       A dangling StartupObject is cleared alongside (it would point at the
       removed type). Non-conventional layouts (Main outside Program.cs,
       WPF's generated Main) match nothing: the guard below stays as backstop.
       Fully scalar throughout: item vectors appear only in a property VALUE
       (flattened to StfEntryList), never in a condition next to metadata
       (MSB4190) or a list (MSB4099) — both verified fatal. -->
  <ItemGroup>
    <StfEntryProbe Include="**/Program.cs" />
    <StfEntryProbe Include="**/program.cs" />
  </ItemGroup>
  <!-- Flattened to a scalar: conditions accept item vectors in NEITHER
       PropertyGroup (MSB4099, verified) NOR metadata form (MSB4190). -->
  <PropertyGroup>
    <StfEntryList>@(StfEntryProbe)</StfEntryList>
  </PropertyGroup>
  <!-- The Remove needs no probe precondition (non-matching Remove is a
       no-op); the scalars alone scope it to real-exe test slices. -->
  <ItemGroup Condition="'$(StfTestIsTrue)' == 'true' AND '$(UseAppHost)' == 'true' AND '$(PkgMicrosoft_NET_Test_Sdk)' != ''">
    <Compile Remove="**/Program.cs" />
    <Compile Remove="**/program.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(StfTestIsTrue)' == 'true' AND '$(UseAppHost)' == 'true' AND '$(PkgMicrosoft_NET_Test_Sdk)' != ''">
    <StartupObject></StartupObject>
  </PropertyGroup>
  <!-- `dotnet run` executes the PROD slice (`dotnet test` runs the tests).
       WHY A HOOK (not docs): `dotnet run` builds the default (test) slice
       and executes it — the testhost entry runs tests silently instead of
       the app (verified: exit 0, zero output, pass or fail). The SDK offers
       ComputeRunArguments as THE placeholder "for tools to override
       RunCommand/RunArguments/RunWorkingDirectory", so no Run override is
       needed: after it runs, build prod nested (same two-evaluation split
       as pack/publish) and repoint the SDK's own Exec at the prod apphost.
       Args/cwd/exit-code handling stays 100% SDK (RunArguments untouched).
       The prod TargetDir is QUERIED from a nested evaluation (never
       recomputed: custom BaseOutputPath keeps working); the query runs
       after the nested build, so restore is warm and silent (warnings on
       stdout would pollute the captured path). The condition DELIBERATELY
       omits the Pkg check the guard uses: `dotnet run` is two CLI phases
       sharing obj/ (build, then a restore-less Run), and the dual's nested
       prod restore rewrites the closure between them — the Run phase reads
       a prod closure (no Pkg) even in test mode (verified: silent testhost
       instead of the hook). UseAppHost alone scopes it correctly (real
       exes; plain exes without tests nest a harmless identical build).
       Residuals: uncompilable
       *.Test.cs still blocks `run` (the CLI's build phase is test-mode and
       indistinguishable from `build`; only broken-COMPILE, failing asserts
       don't matter); the no-build flag still triggers one nested build;
       `dotnet watch` re-runs the (incremental, fast) nested build per
       iteration. Scoped to real-exe test slices; everything else keeps the
       SDK default (a lib's silent testhost run is unchanged). -->
  <Target Name="StfRunProdSliceInstead"
          AfterTargets="ComputeRunArguments"
          Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfAllowExeTestModeIsTrue)' != 'true' AND '$(UseAppHost)' == 'true'">
    <Message Importance="high" Text="Stf.GoTest: 'dotnet run' executes the PROD slice; 'dotnet test' runs the tests." />
    <StfRunProd Project="$(MSBuildProjectFullPath)" Target="Build" Restore="true" />
    <StfRunProd Project="$(MSBuildProjectFullPath)" Target="Build" GetProperty="TargetDir">
      <Output TaskParameter="PropertyValue" PropertyName="StfProdTargetDir" />
    </StfRunProd>
    <PropertyGroup>
      <RunCommand>$(StfProdTargetDir)$(AssemblyName)$(_NativeExecutableExtension)</RunCommand>
    </PropertyGroup>
  </Target>
  <Target Name="StfFailExeTestMode"
          BeforeTargets="BeforeCompile"
          Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfAllowExeTestModeIsTrue)' != 'true' AND '$(PkgMicrosoft_NET_Test_Sdk)' != '' AND '$(UseAppHost)' == 'true' AND '$(StfEntryList)' == ''">
    <Error Text="Stf.GoTest: entry point plus tests cannot compile: upstream Microsoft.NET.Test.Sdk injects a second Program.Main (CS0017), and no conventional Program.cs was found to drop from the test slice. Exe projects ship prod only: add &lt;StfTest&gt;false&lt;/StfTest&gt; right after &lt;OutputType&gt; (single pass, no flags needed), keep the entry point in Program.cs (auto-dropped in test mode), or remove the test-framework refs. -p:StfTest=true is unsupported for Exe. Silence (only if no entry point collides): -p:StfAllowExeTestMode=true." />
  </Target>

  <!-- Onboarding guardrail: forgetting the Condition on test-framework refs
       fails SILENT (impure prod restore). In a prod evaluation, conditioned
       refs are absent, so any known test-runner id still present is bare.
       Warn loudly (once per id) instead of shipping it quietly. Runner infra
       only: mocks etc. can be legit prod deps and are deliberately excluded.
       Plain == chain (no property functions): == is case-insensitive and
       batching-free of parser risk. Silence: -p:StfAllowBareTestRefs=true. -->
  <Target Name="StfWarnBareTestRefs"
          BeforeTargets="BeforeBuild"
          Condition="'$(StfTestIsTrue)' != 'true' AND '$(StfAllowBareTestRefsIsTrue)' != 'true'">
    <Warning Condition="'%(PackageReference.Identity)' == 'Microsoft.NET.Test.Sdk' OR '%(PackageReference.Identity)' == 'xunit' OR '%(PackageReference.Identity)' == 'xunit.v3' OR '%(PackageReference.Identity)' == 'xunit.runner.visualstudio' OR '%(PackageReference.Identity)' == 'NUnit' OR '%(PackageReference.Identity)' == 'NUnit3TestAdapter' OR '%(PackageReference.Identity)' == 'NUnitLite' OR '%(PackageReference.Identity)' == 'MSTest.TestFramework' OR '%(PackageReference.Identity)' == 'MSTest.TestAdapter' OR '%(PackageReference.Identity)' == 'coverlet.collector' OR '%(PackageReference.Identity)' == 'coverlet.msbuild'"
             Text="Stf.GoTest: test-framework PackageReference '%(PackageReference.Identity)' is missing the StfTest condition: prod restore includes test packages. Use the full StfTest condition from README.md (including false/0/no/n/off) on test-only refs. Silence with -p:StfAllowBareTestRefs=true." />
  </Target>

  <!-- WHY THE CONSUMER DECLARES ITS OWN CONDITIONED REFS (no auto-injection):
       graph restore (dotnet restore/build/test) evaluates the project with
       ExcludeRestorePackageImports=true: package-provided MSBuild is
       deliberately invisible to dependency collection, so neither a
       BeforeTargets="CollectPackageReferences" hook (that target never runs
       under graph restore) nor a static promotion ItemGroup here can add
       PackageReferences. Tried both (0.1.18/0.1.19), verified dead with
       -getItem vs dgspec. The onboarding floor is therefore one copy-paste
       snippet in the consumer csproj (see demo): framework refs under
       Condition="'$(StfTest)' != 'false'" + PrivateAssets="all". The condition
       survives bare graph evaluation (flag via -p:/env, fail-open default);
       PrivateAssets feeds the deploy filter below and the nuspec.
       Property-driven generation (Stf.Framework-style) dies on the same wall:
       the declaration would be visible but the PackageReference it generates
       lives in our files, hence invisible. Declaration syntax is irrelevant;
       generation SITE is what matters. -->

  <!-- NOTE: renaming the test assembly (Demo.Test.dll) was tried and reverted:
       too many SDK paths (TargetRefPath, IntermediateRefAssembly, moniker
       attributes, ...) freeze from AssemblyName BEFORE a package's .targets
       can intervene. Slices are distinguished by output folder + build message
       instead: bin/test/*.dll vs bin/*.dll. -->

  <!-- Separate intermediates per slice (restore stays shared: only
       IntermediateOutputPath moves, never BaseIntermediateOutputPath, so no
       MSB3539 and no restore/build split). Derived by injecting test/ under the
       configured base, so custom BaseIntermediateOutputPath keeps working. The
       StartsWith guard is load-bearing, not paranoia: String.Replace hits ANY
       occurrence, so without it a custom IntermediateOutputPath embedding the
       base mid-path would get test/ injected there. Non-prefixed values no-op
       cleanly and the marker guard below remains the staleness backstop. -->
  <PropertyGroup Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfSeparateOutputsIsTrue)' == 'true' AND '$(BaseIntermediateOutputPath)' != '' AND $([System.String]::Copy(&quot;$(IntermediateOutputPath)&quot;).StartsWith(&quot;$(BaseIntermediateOutputPath)&quot;))">
    <_StfOriginalDocumentationFile Condition="'$(DocumentationFile)' == '$(IntermediateOutputPath)$(AssemblyName).xml'">$(DocumentationFile)</_StfOriginalDocumentationFile>
    <StfTestIntermediateRoot>$(BaseIntermediateOutputPath)test/</StfTestIntermediateRoot>
    <IntermediateOutputPath>$(IntermediateOutputPath.Replace($(BaseIntermediateOutputPath), $(StfTestIntermediateRoot)))</IntermediateOutputPath>
    <DocumentationFile Condition="'$(_StfOriginalDocumentationFile)' != ''">$(IntermediateOutputPath)$(AssemblyName).xml</DocumentationFile>
    <!-- TargetRefPath freezes from the default IntermediateOutputPath before this
         file imports (same for IntermediateRefAssembly in SDKs where it doesn't
         follow). Re-derive with the separated paths, mirroring the SDK logic. -->
    <TargetRefPath Condition="'$(ProduceReferenceAssemblyInOutDir)' == 'true'">$([MSBuild]::NormalizePath($(TargetDir), 'ref', $(TargetFileName)))</TargetRefPath>
    <TargetRefPath Condition="'$(ProduceReferenceAssemblyInOutDir)' != 'true'">$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), 'ref', $(TargetFileName)))</TargetRefPath>
  </PropertyGroup>

  <!-- NuGet snapshots output-group returns before AfterTargets executes.
       Correct the collected items just before PackTask consumes them. Their
       intermediate identities identify the test artifacts; FinalOutputPath
       can still contain the production path frozen during SDK evaluation.
       Limit this to our separated intermediates so custom pack items retain
       their producer's source metadata. This also works without a build and
       in the outer evaluation of a multi-framework pack. -->
  <Target Name="StfSelectTestPackSources" BeforeTargets="GenerateNuspec"
          Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfSeparateOutputsIsTrue)' == 'true' AND '$(BaseIntermediateOutputPath)' != ''">
    <PropertyGroup>
      <_StfPackIntermediateRoot>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), 'test'))</_StfPackIntermediateRoot>
    </PropertyGroup>
    <ItemGroup>
      <_BuildOutputInPackage Condition="$([System.String]::Copy('%(_BuildOutputInPackage.FullPath)').StartsWith('$(_StfPackIntermediateRoot)'))">
        <FinalOutputPath>%(_BuildOutputInPackage.FullPath)</FinalOutputPath>
      </_BuildOutputInPackage>
      <_TargetPathsToSymbols Condition="$([System.String]::Copy('%(_TargetPathsToSymbols.FullPath)').StartsWith('$(_StfPackIntermediateRoot)'))">
        <FinalOutputPath>%(_TargetPathsToSymbols.FullPath)</FinalOutputPath>
      </_TargetPathsToSymbols>
    </ItemGroup>
  </Target>

  <!-- Test-only runtime deployment. Consumers mark test-framework refs
       PrivateAssets=all (keeps the prod nuspec clean), which also suppresses
       their runtime copy to output. In test mode only, copy the suppressed
       (Private=false) resolved references next to the test slice so testhost
       finds everything. Compile-only targeting-pack refs never carry
       Private=false, so they are excluded by construction. Satellite/culture
       dlls deploy with the rest (trimming to English fallback was rejected:
       partial deploys break adapters silently); Exe apphosts are out of
       scope (test slices are libraries). -->
  <Target Name="StfDeployPrivateTestDeps"
          AfterTargets="ResolveAssemblyReferences"
          Condition="'$(StfTestIsTrue)' == 'true'">
    <ItemGroup>
      <StfPrivateRef Include="@(Reference->'%(HintPath)')"
                     Condition="'%(Reference.Private)' == 'false' AND '%(Reference.HintPath)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(StfPrivateRef)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Restore-mode marker. obj/ is shared between slices but each mode has a
       different dependency closure, and NuGet's restore no-op check is blind
       to StfTest: without this, flipping modes with warm obj/ silently reuses
       foreign assets (prod RAR copying test deps into bin/, or test compile
       failing loud against prod assets). Before every Restore, compare the
       recorded mode with the current one (absent marker counts as mismatch:
       assets may have been written bare, before this wiring existed) and wipe
       the restore outputs to force a real re-collect. The g.props/g.targets
       stay: they are what loads this wiring. After a successful Restore,
       record the mode (skipped on failure, so the next run retries). -->
  <Target Name="StfCheckRestoreMode" BeforeTargets="Restore">
    <PropertyGroup>
      <StfRestoreModeFile>$(BaseIntermediateOutputPath)stf-restore-mode.txt</StfRestoreModeFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(StfRestoreModeFile)" Condition="Exists('$(StfRestoreModeFile)')">
      <Output TaskParameter="Lines" PropertyName="StfRestoreModeRecorded" />
    </ReadLinesFromFile>
    <Delete Files="$(MSBuildProjectExtensionsPath)project.assets.json;$(MSBuildProjectExtensionsPath)project.nuget.cache"
            Condition="'$(StfRestoreModeRecorded)' != '$(StfTest)'" />
  </Target>
  <Target Name="StfRecordRestoreMode" AfterTargets="Restore">
    <WriteLinesToFile File="$(StfRestoreModeFile)" Lines="$(StfTest)" Overwrite="true" />
  </Target>

  <!-- Dual build: a default build (or test) also refreshes the prod slice via a
       nested build, so both assemblies exist after one command. The nested
       build restores first: sharing the test closure's assets would make prod
       RAR copy test deps next to the prod dll (the dll itself stays pure, but
       bin/ must not). Restore and Build run in SEPARATE dotnet msbuild processes: a single
       Restore;Build invocation evaluates once, so its Build would keep the
       pre-restore imports (Test SDK targets) and copy test files next to the
       prod dll. dotnet build itself splits restore/build passes for the same
       reason. The marker above re-heals obj/ back to test mode on the next
       test-mode restore, so steady-state cost is one warm restore per mode
       flip. StfNested guards recursion; StfDualBuild=false opts out.
       Asymmetric by design: explicit prod builds don't compile tests, so CI
       stays fast. All nested steps assume a `dotnet` on PATH (same one that
       runs the outer build; environment, hence NuGet config, is inherited). -->
  <!-- FIRES ONCE, from the first-TFM inner (single-TFM: the only build).
       The multi-TFM dispatcher CANNOT host it: dispatcher evaluations skip
       package imports (verified: StfTest empty there), so our wiring — hook
       included — only exists in inners. Firing from every inner is wrong: N
       nested full builds racing over shared obj/. The nested restore drops
       the invoker's TargetFramework global (RemoveProperties): without that
       it writes single-TFM assets that break the other inners (NETSDK1005,
       verified). -f <other-tfm> skips the dual (narrow stays narrow);
       -f <first-tfm> duals fully (harmless superset). -->
  <PropertyGroup>
    <StfFirstTfm Condition="'$(TargetFrameworks)' == ''">$(TargetFramework)</StfFirstTfm>
    <StfFirstTfm Condition="'$(TargetFrameworks)' != ''">$([System.String]::Copy('$(TargetFrameworks)').Split(';')[0])</StfFirstTfm>
  </PropertyGroup>
  <!-- StfSeparateOutputs=false opts the dual OUT: both slices share one
       output dir, so a nested prod build would clobber the test closure
       before VSTest runs (verified: testhost dies on missing test deps).
       Single dir means the default commands leave the TEST slice behind;
       prod arrives via an explicit -p:StfTest=false build. -->
  <Target Name="StfBuildProdSliceToo"
          AfterTargets="Build"
          Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfDualBuildIsFalse)' != 'true' AND '$(StfSeparateOutputsIsFalse)' != 'true' AND '$(StfNested)' == '' AND '$(TargetFramework)' == '$(StfFirstTfm)' AND ('$(StfSdkMode)' != 'true' OR '$(GeneratePackageOnBuild)' != 'true' OR '$(StfAllowPackIsFalse)' == 'true')">
    <!-- Restore and Build use separate processes with the same global properties. -->
    <StfRunProd Project="$(MSBuildProjectFullPath)" Target="Build" AllFrameworks="true" Restore="true" />
  </Target>

  <!-- Clean mirrors the dual: a default clean wipes the test slice (via the
       separator hook above) plus the prod slice via one nested prod clean,
       so 'dotnet clean' + 'dotnet build'/'rebuild' behave like a plain
       project. Same once-only rule (first-TFM inner), same opt-outs
       (StfDualBuild=false leaves prod alone, shared-dir clean already wiped
       the single dir). Without the nested half, prod outputs would survive
       every default clean. -->
  <Target Name="StfCleanProdSliceToo"
          AfterTargets="Clean"
          Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfDualBuildIsFalse)' != 'true' AND '$(StfSeparateOutputsIsFalse)' != 'true' AND '$(StfNested)' == '' AND '$(TargetFramework)' == '$(StfFirstTfm)'">
    <StfRunProd Project="$(MSBuildProjectFullPath)" Target="Clean" AllFrameworks="true" Restore="false" />
  </Target>

  <!-- Every real build states which slice it produced. AfterTargets=Build runs
       for build/test/pack-inner-builds but not for IDE design-time builds. -->
  <Target Name="StfReportSlice" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Message Importance="high" Condition="'$(StfTestIsTrue)' == 'true'"
             Text="Stf.GoTest: TEST slice built: $(TargetPath) (prod: dotnet build -p:StfTest=false)" />
    <Message Importance="high" Condition="'$(StfTestIsTrue)' != 'true'"
             Text="Stf.GoTest: PROD slice built: $(TargetPath)" />
  </Target>

  <!--
    Prod compilation: strip Go-style test files. Singular *.Test.cs (like Go's
    _test.go) is the documented convention; plural *.Tests.cs is stripped too,
    each in both casings: MSBuild globs are case-sensitive on Linux, so a
    lowercase *.test.cs would otherwise ship in prod SILENTLY (a helper
    shipped). Over-stripping fails LOUD (missing type in prod),
    under-stripping fails SILENT. This file is imported AFTER the SDK's
    default Compile items, so Remove matches them. Nothing to edit per repo.
  -->
  <ItemGroup Condition="'$(StfTestIsTrue)' != 'true'">
    <Compile Remove="**/*.Test.cs" />
    <Compile Remove="**/*.Tests.cs" />
    <Compile Remove="**/*.test.cs" />
    <Compile Remove="**/*.tests.cs" />
  </ItemGroup>

  <!-- Rebuild guard: obj/ is shared between modes, and shrinking @(Compile)
       alone does not trigger CoreCompile (outputs stay newer than the remaining
       inputs). Detect a mode flip via a marker file and drop the intermediate
       outputs so the switch can never serve a stale dll. -->
  <Target Name="StfForceRebuildOnModeSwitch" BeforeTargets="BeforeCompile" Condition="'$(StfNested)' == ''">
    <PropertyGroup>
      <StfModeFile>$(IntermediateOutputPath)stf-test-mode.txt</StfModeFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(StfModeFile)" Condition="Exists('$(StfModeFile)')">
      <Output TaskParameter="Lines" PropertyName="StfPreviousMode" />
    </ReadLinesFromFile>
    <!-- Surgical deletes only: wiping IntermediateOutputPath mid-build would also
         remove already-generated sources (AssemblyInfo) and break this build. -->
    <Delete Files="$(TargetPath)"
            Condition="'$(StfPreviousMode)' != '' AND '$(StfPreviousMode)' != '$(StfTest)' AND Exists('$(TargetPath)')" />
    <Delete Files="$(IntermediateOutputPath)$(TargetFileName)"
            Condition="'$(StfPreviousMode)' != '' AND '$(StfPreviousMode)' != '$(StfTest)' AND Exists('$(IntermediateOutputPath)$(TargetFileName)')" />
    <Delete Files="$(IntermediateOutputPath)ref/$(TargetFileName);$(IntermediateOutputPath)refint/$(TargetFileName)"
            Condition="'$(StfPreviousMode)' != '' AND '$(StfPreviousMode)' != '$(StfTest)'" />
    <WriteLinesToFile File="$(StfModeFile)" Lines="$(StfTest)" Overwrite="true" />
  </Target>

  <!-- Register dispatchers after the SDK defines its command targets. They
       replace the outer test command before any test build or copy happens.
       User output properties stay untouched and flow to the prod process. -->
  <PropertyGroup Condition="'$(StfSdkMode)' != 'true' AND '$(StfTestIsTrue)' == 'true' AND '$(StfAllowTestSlicePackIsTrue)' != 'true' AND '$(StfAllowPackIsFalse)' != 'true'">
    <StfOriginalPackTargets Condition="'$(NuGetBuildTasksPackTargets)' != ''">$(NuGetBuildTasksPackTargets)</StfOriginalPackTargets>
    <StfOriginalPackTargets Condition="'$(StfOriginalPackTargets)' == ''">$(MSBuildToolsPath)/NuGet.Build.Tasks.Pack.targets</StfOriginalPackTargets>
    <NuGetBuildTasksPackTargets>$(MSBuildThisFileDirectory)Stf.GoTest.Pack.targets</NuGetBuildTasksPackTargets>
    <ImportNuGetBuildTasksPackTargetsFromSdk Condition="'$(ImportNuGetBuildTasksPackTargetsFromSdk)' == ''">true</ImportNuGetBuildTasksPackTargetsFromSdk>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StfSdkMode)' != 'true' AND '$(StfTestIsTrue)' == 'true' AND '$(StfAllowTestSlicePackIsTrue)' != 'true' AND '$(StfAllowTestSlicePublishIsTrue)' != 'true'">
    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)Stf.GoTest.Publish.targets</AfterMicrosoftNETSdkTargets>
  </PropertyGroup>
</Project>
