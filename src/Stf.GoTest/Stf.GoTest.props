<Project>
  <!--
    Stf.GoTest: Go-style single-project tests for .NET.
    Auto-imported by NuGet via buildTransitive. Consumers only add:
      <PackageReference Include="Stf.GoTest" Version="0.1.x" PrivateAssets="all" />
    No manual <Compile Remove> or InternalsVisibleTo needed.
  -->
  <PropertyGroup>
    <!-- Default true: the IDE evaluates WITHOUT custom -p flags, so the default
         must include tests or IntelliSense / Test Explorer break.
         Prod/CI builds opt out explicitly: dotnet build -p:StfTest=false.
         Exe projects use a thin Program.cs so test mode can remove the
         application entry point. A body-time StfTest=false is an explicit
         prod-only opt-out, not required for the default command behavior. -->
    <StfTest Condition="'$(StfTest)' == ''">true</StfTest>
    <!-- MSBuild has no bool type: every flag is text, and -p:/env values
         are GLOBAL (immutable: no assignment below can rewrite them). So
         conditions never compare a flag directly — they read a canonical
         twin that tolerates every spelling (== is case-insensitive):
         1/yes/y/on count as true, 0/no/n/off as false. Unknown values stay
         unset and keep fail-open test behavior by polarity (see .targets).
         Without this, -p:StfTest=1 silently built PROD and
         -p:StfSeparateOutputs=0 disabled separation while leaving the dual
         on (the shared-dir clobber). Twins redefine at the top of .targets
         (the body runs after props and may change raw values). -->
    <StfTestIsTrue Condition="'$(StfTest)' == 'true' OR '$(StfTest)' == '1' OR '$(StfTest)' == 'yes' OR '$(StfTest)' == 'y' OR '$(StfTest)' == 'on'">true</StfTestIsTrue>
    <StfSeparateOutputs Condition="'$(StfSeparateOutputs)' == ''">true</StfSeparateOutputs>
    <StfSeparateOutputsIsTrue Condition="'$(StfSeparateOutputs)' == 'true' OR '$(StfSeparateOutputs)' == '1' OR '$(StfSeparateOutputs)' == 'yes' OR '$(StfSeparateOutputs)' == 'y' OR '$(StfSeparateOutputs)' == 'on'">true</StfSeparateOutputsIsTrue>
    <StfSeparateOutputsIsFalse Condition="'$(StfSeparateOutputs)' == 'false' OR '$(StfSeparateOutputs)' == '0' OR '$(StfSeparateOutputs)' == 'no' OR '$(StfSeparateOutputs)' == 'n' OR '$(StfSeparateOutputs)' == 'off'">true</StfSeparateOutputsIsFalse>
    <IsTestProject Condition="'$(StfTestIsTrue)' == 'true' AND '$(IsTestProject)' == ''">true</IsTestProject>
    <!-- The SDK defaults this from IsTestProject during its own props, before a
         package can set IsTestProject. Set the derived value directly or the
         test slice gets no runtimeconfig.json and testhost cannot resolve the
         (transitive, non-copied) test dependencies at runtime. -->
    <GenerateRuntimeConfigurationFiles Condition="'$(StfTestIsTrue)' == 'true' AND '$(GenerateRuntimeConfigurationFiles)' == ''">true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StfTestIsTrue)' == 'true'">
    <!-- #DEFINE for the IDE: #if STF_TEST shows test-only code as active and
         grays the prod branch. Go build-constraint equivalent for C#. -->
    <DefineConstants>$(DefineConstants);STF_TEST</DefineConstants>
    <!-- Applied-flag for the body-time healing in .targets (a body-time
         <StfTest>false</StfTest> arrives after this append). -->
    <StfTestDefineApplied>true</StfTestDefineApplied>
  </PropertyGroup>

  <!-- Separation INTENT only (no paths touched here): at props time
       BaseOutputPath is still empty (verified via -pp: SDK defaults and the
       project body assign it later), so deriving the test root here reads
       garbage. Paths separate in the .targets, where the base is final.
       Restore stays shared. -->
  <PropertyGroup Condition="'$(StfTestIsTrue)' == 'true' AND '$(StfSeparateOutputsIsTrue)' == 'true'">
    <!-- Applied-flag: see above. -->
    <StfSeparateTestOutputsApplied>true</StfSeparateTestOutputsApplied>
  </PropertyGroup>
</Project>
