<Project>
  <!-- Unlike a PackageReference import, an SDK participates in NuGet's graph
       evaluation too. Select the production closure before project references
       and conditional PackageReferences are evaluated. -->
  <PropertyGroup>
    <StfSdkMode>true</StfSdkMode>
    <!-- Permissions never select a slice. A body-level StfTest assignment may
         override this default before the consumer's conditional properties. -->
    <StfTest Condition="'$(StfTest)' == '' AND ('$(_IsPublishing)' == 'true' OR '$(_IsPacking)' == 'true')">false</StfTest>
  </PropertyGroup>
  <Import Project="../build/Stf.GoTest.props" />
</Project>
